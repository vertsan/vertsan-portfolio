# ---------------------------------------------------------------------------
# Vert San portfolio — environment variables
#
# Copy this file to `.env` and fill in the values:
#   cp .env.example .env
#
# Local development reads `.env` / `.env.development`.
# Production builds on Netlify read the variables configured in the Netlify UI
# (Site configuration → Environment variables) or imported with:
#   netlify env:import .env
# ---------------------------------------------------------------------------

# Neon Postgres connection string (required)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Public base URL of the site. Used to build OAuth redirect URIs.
# Local: http://localhost:3000
# Production: https://vertsan.netlify.app
BASE_URL=http://localhost:3000

# Admin dashboard credentials (required in production)
# ADMIN_PASSWORD is the password for the admin login form.
# ADMIN_SECRET signs session cookies — use a long random value.
ADMIN_PASSWORD=
ADMIN_SECRET=

# OAuth providers used by the testimonial login flow.
# Authorized redirect URI: ${BASE_URL}/api/auth/{provider}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub token used by /api/download to fetch private GitHub release assets.
# Optional — without it the endpoint redirects to the public URL.
GITHUB_TOKEN=

# Cloudinary connection string used by admin image uploads.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Optional — uploads are disabled without it.
CLOUDINARY_URL=

# AI resume assistant. Set at least one provider; otherwise the endpoint
# falls back to a local Ollama instance (not available on Netlify).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
